{
    "name": "poetry-for-neanderthals",
    "private": true,
    "scripts": {
        "build": "ng build --verbose",
        "build:dev": "ng build --verbose --watch --configuration dev",
        "knip": "knip",
        "lint": "ng lint --fix --max-warnings=0",
        "prepare": "husky && sort-package-json",
        "prettier": "prettier --write .",
        "start": "ng serve"
    },
    "lint-staged": {
        "*": [
            "eslint --fix --max-warnings=0 --no-warn-ignored",
            "prettier --write --ignore-unknown"
        ]
    },
    "dependencies": {
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/platform-browser": "^22.2.4",
        "@angular/router": "^22.2.4",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.2",
        "crypto-js": "^4.2.0",
        "lodash": "^4.18.1",
        "ngx-logger": "^5.0.12",
        "rxjs": "~7.8.2",
        "seedrandom": "^3.0.5",
        "sort-package-json": "^4.1.0",
        "tslib": "^2.8.1",
        "uuid": "^14.0.3",
        "zone.js": "~0.16.3"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^22.6.0",
        "@angular/build": "^22.2.5",
        "@angular/cli": "^22.2.5",
        "@angular/compiler-cli": "^22.2.4",
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^10.0.1",
        "@types/bootstrap": "^5.2.11",
        "@types/crypto-js": "^4.2.2",
        "@types/lodash": "^4.17.27",
        "@types/seedrandom": "^3.0.8",
        "angular-eslint": "22.6.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "knip": "^6.44.0",
        "lint-staged": "^17.6.0",
        "npm-check-updates": "^22.2.9",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "allowScripts": {
        "@parcel/watcher": true,
        "esbuild": true,
        "fsevents": true,
        "lmdb": true,
        "msgpackr-extract": true
    }
}
